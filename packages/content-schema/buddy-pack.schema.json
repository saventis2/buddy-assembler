{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Reference schema only. packages/content-validator/validate_pack.py is a dependency-free, hand-rolled checker that mirrors this document's intent -- it does not load or evaluate this file through a JSON Schema engine. Keep the two in sync manually. Run `python validate_pack.py --check-schema` to confirm this document is itself a structurally valid draft 2020-12 schema.",
  "$id": "https://buddy-assembler.dev/schemas/buddy-pack.schema.json",
  "title": "Buddy Content Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "companion",
    "idleActions",
    "reactionActions",
    "encounterActions",
    "eventRules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "runtimeAudience": {
      "type": "string",
      "enum": ["user", "development"],
      "default": "user"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "companion": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "traits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "properties": {
        "faceMode": {
          "type": "string",
          "enum": ["embedded"],
          "default": "embedded"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "animations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sprites": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "idleActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reactionActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "encounterActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eventRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "weight",
          "cooldownSeconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "perHour": {
            "type": "integer",
            "minimum": 1
          },
          "perDay": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "rarity",
          "primaryTheme"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "rarity": { "type": "string", "minLength": 1 },
          "primaryTheme": { "type": "string", "minLength": 1 },
          "secondaryThemes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "effectProfile": { "type": "object" }
        }
      }
    },
    "currencies": {
      "type": "object",
      "properties": {
        "crystals": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rewardBoxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "theme",
          "cost"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "theme": { "type": "string", "minLength": 1 },
          "cost": { "type": "integer", "minimum": 1 },
          "categoryBias": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "possibleItems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rarityTable": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "home": {
      "type": "object",
      "properties": {
        "sceneId": { "type": "string", "minLength": 1 },
        "decorSlots": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "affinity": { "type": "integer" },
          "availability": { "type": "string", "minLength": 1 },
          "dialoguePool": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "npcId": { "type": "string", "minLength": 1 },
          "requirements": { "type": "object" },
          "rewards": { "type": "object" },
          "repeatability": { "type": "string", "minLength": 1 },
          "narrativeText": { "type": "string", "minLength": 1 }
        }
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "npcId": { "type": "string", "minLength": 1 },
          "narrativeText": { "type": "string", "minLength": 1 },
          "rewardsEngage": { "type": "object" },
          "rewardsSkip": { "type": "object" }
        }
      }
    }
  }
}
